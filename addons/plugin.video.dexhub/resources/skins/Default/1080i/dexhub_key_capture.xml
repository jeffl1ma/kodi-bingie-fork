<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal modal used only while capturing a user-selected source-switch key. -->
<window type="dialog">
  <defaultcontrol always="true">100</defaultcontrol>
  <zorder>20</zorder>
  <animation effect="fade" start="0" end="100" time="160">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="B8000000">black.png</texture>
    </control>
    <control type="image">
      <left>470</left><top>350</top><width>980</width><height>380</height>
      <texture border="32">glass_panel.png</texture>
    </control>
    <control type="image">
      <left>520</left><top>375</top><width>880</width><height>4</height>
      <texture>brand_stripe.png</texture>
    </control>
    <control type="label" id="100">
      <left>540</left><top>425</top><width>840</width><height>52</height>
      <font>font30_title</font><textcolor>FFFFFFFF</textcolor><align>center</align>
      <label>$INFO[Window.Property(dexhub.keycapture.title)]</label>
    </control>
    <control type="textbox">
      <left>580</left><top>500</top><width>760</width><height>100</height>
      <font>font16</font><textcolor>FFE5DEFF</textcolor><align>center</align>
      <label>$INFO[Window.Property(dexhub.keycapture.message)]</label>
    </control>
    <control type="label">
      <left>540</left><top>635</top><width>840</width><height>38</height>
      <font>font13</font><textcolor>FFFFB4B4</textcolor><align>center</align>
      <label>$INFO[Window.Property(dexhub.keycapture.error)]</label>
    </control>
  </controls>
</window>

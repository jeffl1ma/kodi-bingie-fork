# TEXTOS DE HELP/DESCRIÇÃO (32500–32572)
# ============================================================

# --- Interface e Geral ---

#. Help: movie.enable_details
msgctxt "#32500"
msgid "Exibe a tela de detalhes ao clicar em um filme. Se desativado, vai direto para a seleção de fontes."
msgstr "Exibe a tela de detalhes ao clicar em um filme. Se desativado, vai direto para a seleção de fontes."

#. Help: tvshow.enable_details
msgctxt "#32501"
msgid "Exibe a tela de detalhes ao clicar em uma série. Se desativado, vai direto para a lista de episódios."
msgstr "Exibe a tela de detalhes ao clicar em uma série. Se desativado, vai direto para a lista de episódios."

# --- Reprodução ---

#. Help: playback.show_resolver_window
msgctxt "#32502"
msgid "Mostra tela de progresso enquanto o link é resolvido. Se desativado, reproduz direto sem janela visual."
msgstr "Mostra tela de progresso enquanto o link é resolvido. Se desativado, reproduz direto sem janela visual."

#. Help: playback.autoplay
msgctxt "#32503"
msgid "Escolhe a melhor fonte automaticamente ao clicar em um título, sem abrir a tela de seleção."
msgstr "Escolhe a melhor fonte automaticamente ao clicar em um título, sem abrir a tela de seleção."

#. Help: autoplay.quality
msgctxt "#32504"
msgid "O autoplay tentará escolher uma fonte nesta qualidade. Se não encontrar, usa a mais próxima disponível."
msgstr "O autoplay tentará escolher uma fonte nesta qualidade. Se não encontrar, usa a mais próxima disponível."

#. Help: autoplay.language
msgctxt "#32505"
msgid "PT-BR = Dublado · DUAL = Dublado+Original · LEG = Legendado · Qualquer = sem preferência"
msgstr "PT-BR = Dublado · DUAL = Dublado+Original · LEG = Legendado · Qualquer = sem preferência"

#. Help: autoplay.source_type
msgctxt "#32506"
msgid "Direct = link direto (HTTP/HLS) · Torrent = torrent/magnet · Qualquer = sem preferência. Se não disponível, usa o outro."
msgstr "Direct = link direto (HTTP/HLS) · Torrent = torrent/magnet · Qualquer = sem preferência. Se não disponível, usa o outro."

#. Help: playback.preferred_quality
msgctxt "#32507"
msgid "Ordena a lista de fontes pela qualidade mais próxima da preferida. Não afeta o Autoplay acima."
msgstr "Ordena a lista de fontes pela qualidade mais próxima da preferida. Não afeta o Autoplay acima."

#. Help: playback.autonext_episode
msgctxt "#32508"
msgid "Reproduz o próximo episódio automaticamente ao terminar. Independente do Autoplay acima."
msgstr "Reproduz o próximo episódio automaticamente ao terminar. Independente do Autoplay acima."

#. Help: autonext.language
msgctxt "#32509"
msgid "\"Igual ao Autoplay\" herda a preferência de idioma configurada acima."
msgstr "\"Igual ao Autoplay\" herda a preferência de idioma configurada acima."

#. Help: autonext.source_type
msgctxt "#32510"
msgid "\"Igual ao Autoplay\" herda o tipo de fonte configurado acima."
msgstr "\"Igual ao Autoplay\" herda o tipo de fonte configurado acima."

#. Help: next_episode.trigger_seconds
msgctxt "#32511"
msgid "Tempo restante para exibir o aviso do próximo episódio."
msgstr "Tempo restante para exibir o aviso do próximo episódio."

#. Help: next_episode.timeout
msgctxt "#32512"
msgid "Quantos segundos o usuário tem para cancelar antes do próximo episódio começar."
msgstr "Quantos segundos o usuário tem para cancelar antes do próximo episódio começar."

#. Help: watchlist_auto_remove
msgctxt "#32513"
msgid "Perguntar ao concluir um conteúdo se deseja removê-lo da lista Quero Assistir."
msgstr "Perguntar ao concluir um conteúdo se deseja removê-lo da lista Quero Assistir."

#. Help: rating_dialog.enabled
msgctxt "#32514"
msgid "Ao atingir 80% do conteúdo, exibe um dialog rápido para avaliar se gostou ou não."
msgstr "Ao atingir 80% do conteúdo, exibe um dialog rápido para avaliar se gostou ou não."

#. Help: rating_dialog.timeout
msgctxt "#32515"
msgid "Se o usuário não interagir, o dialog de avaliação fecha sozinho após este tempo."
msgstr "Se o usuário não interagir, o dialog de avaliação fecha sozinho após este tempo."

# --- Recomendações ---

#. Help: min_progress
msgctxt "#32520"
msgid "Percentual mínimo de progresso para contar como assistido e usar nas recomendações."
msgstr "Percentual mínimo de progresso para contar como assistido e usar nas recomendações."

#. Help: min_items
msgctxt "#32521"
msgid "Quantidade mínima de títulos assistidos para gerar recomendações personalizadas."
msgstr "Quantidade mínima de títulos assistidos para gerar recomendações personalizadas."

#. Help: min_rating
msgctxt "#32522"
msgid "Apenas recomenda títulos com nota igual ou superior a este valor."
msgstr "Apenas recomenda títulos com nota igual ou superior a este valor."

#. Help: recommendations_limit
msgctxt "#32523"
msgid "Número máximo de recomendações exibidas por categoria (Filmes/Séries)."
msgstr "Número máximo de recomendações exibidas por categoria (Filmes/Séries)."

#. Help: diversity_factor
msgctxt "#32524"
msgid "0 = baseado em similaridade. 1 = máxima diversidade. Valores altos trazem mais variedade."
msgstr "0 = baseado em similaridade. 1 = máxima diversidade. Valores altos trazem mais variedade."


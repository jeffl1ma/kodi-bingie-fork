<window type="window" fullscreen="true">
    <coordinates>
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>1080</height>
    </coordinates>

    <controls>

        <!-- Fundo -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF0A0F24">AddonWindow/white.png</texture>
        </control>

        <!-- ══════════════════════════════════════════
             FANART (fullscreen, com fade-in suave)
        ══════════════════════════════════════════ -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture background="true">$INFO[Window().Property(info.fanart)]</texture>
            <aspectratio align="center" aligny="center">scale</aspectratio>
            <visible>!String.IsEmpty(Window().Property(info.fanart))</visible>
            <animation effect="fade" start="0" end="100" time="600">WindowOpen</animation>
        </control>

        <!-- ══════════════════════════════════════════
             GRADIENT OVERLAY
        ══════════════════════════════════════════ -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="DD000000">AddonWindow/white.png</texture>
            <animation effect="fade" start="0" end="100" time="500">WindowOpen</animation>
        </control>

        <!-- ══════════════════════════════════════════
             ADDON LOGO (canto superior esquerdo)
        ══════════════════════════════════════════ -->
        <control type="image">
            <right>20</right>
            <top>0</top>
            <width>100</width>
            <height>100</height>
            <texture>logo.png</texture>
            <animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
        </control>

        <!-- ══════════════════════════════════════════
             CLEARLOGO (centro, grande)
        ══════════════════════════════════════════ -->
        <control type="image">
            <centerleft>960</centerleft>
            <centertop>400</centertop>
            <width>900</width>
            <height>280</height>
            <aspectratio>keep</aspectratio>
            <texture>$INFO[Window().Property(info.clearlogo)]</texture>
            <visible>!String.IsEmpty(Window().Property(info.clearlogo))</visible>
            <animation effect="fade" start="0" end="100" time="700" delay="150">WindowOpen</animation>
            <animation effect="zoom" start="95" end="100" time="700" delay="150">WindowOpen</animation>
        </control>

        <!-- TITLE (fallback sem clearlogo) -->
        <control type="label">
            <centerleft>960</centerleft>
            <centertop>390</centertop>
            <width>1600</width>
            <height>100</height>
            <align>center</align>
            <font>font_MainMenu</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>DD000000</shadowcolor>
            <label>$INFO[Window().Property(info.title)]</label>
            <visible>String.IsEmpty(Window().Property(info.clearlogo))</visible>
            <animation effect="fade" start="0" end="100" time="600" delay="150">WindowOpen</animation>
        </control>

        <!-- ── 4K (dourado) ── -->
        <control type="group">
            <left>705</left>
            <top>590</top>
            <animation effect="fade" start="0" end="100" time="500" delay="200">WindowOpen</animation>
            <!-- fundo: disco escuro quase transparente -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>90</width><height>90</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="11FFFFFF">circle.png</texture>
            </control>
            <!-- rótulo "4K" -->
            <control type="label">
                <left>0</left><top>10</top>
                <width>90</width><height>26</height>
                <align>center</align>
                <font>font18</font>
                <textcolor>FFFFD700</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>2160P</label>
            </control>
            <!-- número -->
            <control type="label">
                <left>0</left><top>43</top>
                <width>90</width><height>46</height>
                <align>center</align>
                <font>font28</font>
                <textcolor>FFFFD700</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window().Property(search.count_4k)]</label>
            </control>
        </control>

        <!-- ── 1080p (verde-teal) ── -->
        <control type="group">
            <left>845</left>
            <top>590</top>
            <animation effect="fade" start="0" end="100" time="500" delay="300">WindowOpen</animation>
            <control type="image">
                <left>0</left><top>0</top>
                <width>90</width><height>90</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="11FFFFFF">circle.png</texture>
            </control>
            <control type="label">
                <left>0</left><top>10</top>
                <width>90</width><height>26</height>
                <align>center</align>
                <font>font18</font>
                <textcolor>FF4CAF83</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>1080P</label>
            </control>
            <control type="label">
                <left>0</left><top>43</top>
                <width>90</width><height>46</height>
                <align>center</align>
                <font>font28</font>
                <textcolor>FF4CAF83</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window().Property(search.count_1080)]</label>
            </control>
        </control>

        <!-- ── 720p (azul-slate) ── -->
        <control type="group">
            <left>985</left>
            <top>590</top>
            <animation effect="fade" start="0" end="100" time="500" delay="400">WindowOpen</animation>
            <control type="image">
                <left>0</left><top>0</top>
                <width>90</width><height>90</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="11FFFFFF">circle.png</texture>
            </control>
            <control type="label">
                <left>0</left><top>10</top>
                <width>90</width><height>26</height>
                <align>center</align>
                <font>font18</font>
                <textcolor>FF6495ED</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>720P</label>
            </control>
            <control type="label">
                <left>0</left><top>43</top>
                <width>90</width><height>46</height>
                <align>center</align>
                <font>font28</font>
                <textcolor>FF6495ED</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window().Property(search.count_720)]</label>
            </control>
        </control>

        <!-- ── SD (cinza) ── -->
        <control type="group">
            <left>1125</left>
            <top>590</top>
            <animation effect="fade" start="0" end="100" time="500" delay="500">WindowOpen</animation>
            <control type="image">
                <left>0</left><top>0</top>
                <width>90</width><height>90</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="11FFFFFF">circle.png</texture>
            </control>
            <control type="label">
                <left>0</left><top>10</top>
                <width>90</width><height>26</height>
                <align>center</align>
                <font>font18</font>
                <textcolor>FFAAAAAA</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>SD</label>
            </control>
            <control type="label">
                <left>0</left><top>43</top>
                <width>90</width><height>46</height>
                <align>center</align>
                <font>font28</font>
                <textcolor>FFAAAAAA</textcolor>
                <shadowcolor>FF000000</shadowcolor>
                <label>$INFO[Window().Property(search.count_sd)]</label>
            </control>
        </control>


        <!-- ══════════════════════════════════════════
             ELAPSED TIME
        ══════════════════════════════════════════ -->
        <control type="label">
            <centerleft>960</centerleft>
            <top>696</top>
            <width>400</width>
            <height>28</height>
            <align>center</align>
            <font>font18</font>
            <textcolor>AAFFFFFF</textcolor>
            <shadowcolor>CC000000</shadowcolor>
            <label>$INFO[Window().Property(search.elapsed)]</label>
            <visible>!String.IsEmpty(Window().Property(search.elapsed))</visible>
        </control>

        <!-- ══════════════════════════════════════════
             REMAINING PROVIDERS
        ══════════════════════════════════════════ -->
        <control type="label">
            <centerleft>960</centerleft>
            <top>730</top>
            <width>1400</width>
            <height>30</height>
            <align>center</align>
            <font>font20</font>
            <textcolor>FF6495ED</textcolor>
            <shadowcolor>CC000000</shadowcolor>
            <label>$INFO[Window().Property(search.remaining)]</label>
            <visible>!String.IsEmpty(Window().Property(search.remaining))</visible>
            <animation effect="fade" start="0" end="100" time="500" delay="350">WindowOpen</animation>
        </control>

        <!-- ══════════════════════════════════════════
             SPINNER
        ══════════════════════════════════════════ -->
        <control type="image">
            <centerleft>960</centerleft>
            <centertop>810</centertop>
            <width>55</width>
            <height>55</height>
            <aspectratio>keep</aspectratio>
            <texture>spinner.png</texture>
            <animation effect="fade" start="0" end="100" time="400" delay="600">WindowOpen</animation>
            <animation effect="rotate"
                       start="0"
                       end="360"
                       center="960,810"
                       time="1000"
                       loop="true"
                       condition="true">Conditional</animation>
        </control>

    </controls>
</window>
<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">103</defaultcontrol>
    <onback>Close</onback>

    <!-- Animações de abertura -->
    <animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
    <animation effect="zoom" start="90,90" end="100,100" center="960,540" time="400" tween="cubic" easing="out">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="250">WindowClose</animation>

    <controls>

        <!-- Fundo sólido -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF1A1C20">white.png</texture>
        </control>

        <!-- Gradiente overlay -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="gradient">white.png</texture>
            <colordiffuse>6630333A</colordiffuse>
            <aspectratio>stretch</aspectratio>
        </control>

        <!-- CONTAINER PRINCIPAL -->
        <control type="group">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>

            <!-- LOGO NO TOPO -->
            <control type="image">
                <left>760</left>
                <top>-10</top>
                <width>400</width>
                <height>175</height>
                <align>center</align>
                <texture>logo.png</texture>
                <aspectratio>keep</aspectratio>
            </control>

            <!-- TÍTULO -->
            <control type="label">
                <left>0</left>
                <top>130</top>
                <width>1920</width>
                <height>80</height>
                <align>center</align>
                <font>font45_title</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>Quem está assistindo?</label>
            </control>

            <!-- LISTA DE PERFIS -->
            <control type="fixedlist" id="50">
                <left>260</left>
                <top>260</top>
                <width>1400</width>
                <height>460</height>
                <orientation>horizontal</orientation>
                <focusposition>1</focusposition>
                <movement>2</movement>
                <scrolltime>250</scrolltime>

                <onup>50</onup>
                <ondown>101</ondown>
                <onleft>50</onleft>
                <onright>50</onright>

                <!-- ITEM NORMAL (não focado) -->
                <itemlayout width="300" height="460">
                    <control type="group">
                        <left>50</left>
                        <top>20</top>

                        <!-- AVATAR -->
                        <control type="image">
                            <left>50</left>
                            <top>10</top>
                            <width>200</width>
                            <height>200</height>
                            <texture>$INFO[ListItem.Icon]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>

                        <!-- CADEADO -->
                        <control type="image">
                            <left>185</left>
                            <top>-5</top>
                            <width>70</width>
                            <height>70</height>
                            <texture>Profile\lock_icon.png</texture>
                            <aspectratio>keep</aspectratio>
                            <visible>String.IsEqual(ListItem.Property(has_pin), true)</visible>
                        </control>

                        <!-- BADGE KIDS -->
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>60</width>
                            <height>60</height>
                            <texture>Profile\kids_badge.png</texture>
                            <aspectratio>keep</aspectratio>
                            <visible>String.IsEqual(ListItem.Property(is_kids), true)</visible>
                        </control>

                        <!-- NOME -->
                        <control type="label">
                            <left>0</left>
                            <top>225</top>
                            <width>280</width>
                            <height>40</height>
                            <align>center</align>
                            <font>font16</font>
                            <textcolor>CCFFFFFF</textcolor>
                            <label>$INFO[ListItem.Label]</label>
                        </control>

                        <!-- ÚLTIMO ACESSO -->
                        <control type="label">
                            <left>0</left>
                            <top>265</top>
                            <width>280</width>
                            <height>30</height>
                            <align>center</align>
                            <font>font10</font>
                            <textcolor>66FFFFFF</textcolor>
                            <label>$INFO[ListItem.Label2]</label>
                        </control>

                        <!-- BARRA DE PROGRESSO (não focado, discreta) -->
                        <control type="group">
                            <left>40</left>
                            <top>302</top>
                            <visible>!String.IsEmpty(ListItem.Property(watch_progress))</visible>
                            <control type="image">
                                <left>0</left><top>0</top>
                                <width>200</width><height>4</height>
                                <texture>Profile\progress_bg.png</texture>
                            </control>
                            <control type="image">
                                <left>0</left><top>0</top>
                                <width>$INFO[ListItem.Property(watch_progress)]</width>
                                <height>4</height>
                                <texture colordiffuse="66aa4de5">Profile\progress_fill.png</texture>
                            </control>
                        </control>

                        <!-- TEMPO ASSISTIDO (não focado, bem discreto) -->
                        <control type="label">
                            <left>0</left>
                            <top>314</top>
                            <width>280</width>
                            <height>20</height>
                            <align>center</align>
                            <font>font10</font>
                            <textcolor>33aa4de5</textcolor>
                            <label>$INFO[ListItem.Property(stat_time)]</label>
                            <visible>!String.IsEmpty(ListItem.Property(stat_time))</visible>
                        </control>

                    </control>
                </itemlayout>

                <!-- ITEM FOCADO -->
                <focusedlayout width="300" height="460">
                    <control type="group">
                        <left>50</left>
                        <top>20</top>

                        <!-- GLOW EFFECT -->
                        <control type="image">
                            <left>15</left>
                            <top>-15</top>
                            <width>250</width>
                            <height>250</height>
                            <texture colordiffuse="55aa4de5">Profile\circle_purple.png</texture>
                            <aspectratio>keep</aspectratio>
                            <animation effect="fade" start="0" end="100" time="400" tween="sine" easing="out">Focus</animation>
                            <animation effect="fade" start="100" end="0" time="200">UnFocus</animation>
                        </control>

                        <!-- AVATAR (ligeiramente maior ao focar) -->
                        <control type="image">
                            <left>40</left>
                            <top>5</top>
                            <width>220</width>
                            <height>220</height>
                            <texture>$INFO[ListItem.Icon]</texture>
                            <aspectratio>scale</aspectratio>
                        </control>

                        <!-- CADEADO -->
                        <control type="image">
                            <left>185</left>
                            <top>-5</top>
                            <width>70</width>
                            <height>70</height>
                            <texture>Profile\lock_icon.png</texture>
                            <aspectratio>keep</aspectratio>
                            <visible>String.IsEqual(ListItem.Property(has_pin), true)</visible>
                            <animation effect="fade" start="70" end="100" time="300">Focus</animation>
                        </control>

                        <!-- BADGE KIDS -->
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>60</width>
                            <height>60</height>
                            <texture>Profile\kids_badge.png</texture>
                            <aspectratio>keep</aspectratio>
                            <visible>String.IsEqual(ListItem.Property(is_kids), true)</visible>
                            <animation effect="pulse" start="100" end="110" time="800" pulse="true">Focus</animation>
                        </control>

                        <!-- NOME (destacado) -->
                        <control type="label">
                            <left>0</left>
                            <top>238</top>
                            <width>280</width>
                            <height>38</height>
                            <align>center</align>
                            <font>font18_title</font>
                            <textcolor>FFFFFFFF</textcolor>
                            <label>$INFO[ListItem.Label]</label>
                        </control>

                        <!-- BARRA DE PROGRESSO (focado, cor cheia) -->
                        <control type="group">
                            <left>40</left>
                            <top>280</top>
                            <visible>!String.IsEmpty(ListItem.Property(watch_progress))</visible>
                            <control type="image">
                                <left>0</left><top>0</top>
                                <width>200</width><height>5</height>
                                <texture>Profile\progress_bg.png</texture>
                            </control>
                            <control type="image">
                                <left>0</left><top>0</top>
                                <width>$INFO[ListItem.Property(watch_progress)]</width>
                                <height>5</height>
                                <texture colordiffuse="FFaa4de5">Profile\progress_fill.png</texture>
                            </control>
                        </control>

                        <!-- SEPARADOR -->
                        <control type="image">
                            <left>20</left>
                            <top>293</top>
                            <width>240</width>
                            <height>1</height>
                            <texture colordiffuse="33aa4de5">white.png</texture>
                            <aspectratio>stretch</aspectratio>
                            <visible>!String.IsEmpty(ListItem.Property(stat_time))</visible>
                        </control>

                        <!-- TEMPO ASSISTIDO (focado, destaque roxo) -->
                        <control type="label">
                            <left>0</left>
                            <top>300</top>
                            <width>280</width>
                            <height>28</height>
                            <align>center</align>
                            <font>font16</font>
                            <textcolor>FFAA4DE5</textcolor>
                            <label>$INFO[ListItem.Property(stat_time)]</label>
                            <visible>!String.IsEmpty(ListItem.Property(stat_time))</visible>
                        </control>

                        <!-- LABEL "Tempo assistido" -->
                        <control type="label">
                            <left>0</left>
                            <top>328</top>
                            <width>280</width>
                            <height>20</height>
                            <align>center</align>
                            <font>font10</font>
                            <textcolor>55FFFFFF</textcolor>
                            <label>Tempo assistido</label>
                            <visible>!String.IsEmpty(ListItem.Property(stat_time))</visible>
                        </control>

                    </control>
                </focusedlayout>

            </control>

            <!-- BOTÕES ADICIONAR PERFIL -->
            <control type="grouplist" id="100">
                <left>660</left>
                <top>760</top>
                <width>600</width>
                <height>80</height>
                <orientation>horizontal</orientation>
                <itemgap>30</itemgap>
                <align>center</align>

                <onup>50</onup>
                <ondown>103</ondown>

                <!-- ADICIONAR ADULTO -->
                <control type="button" id="101">
                    <width>280</width>
                    <height>60</height>
                    <font>font14_title</font>
                    <textcolor>99FFFFFF</textcolor>
                    <focusedcolor>FFFFFFFF</focusedcolor>
                    <align>center</align>
                    <label>+ ADULTO</label>
                    <texturefocus colordiffuse="44FFFFFF">Profile\button-focus.png</texturefocus>
                    <texturenofocus colordiffuse="22FFFFFF">Profile\button-nofocus.png</texturenofocus>
                    <onleft>102</onleft>
                    <onright>102</onright>
                    <onup>50</onup>
                    <ondown>103</ondown>
                </control>

                <!-- ADICIONAR KID -->
                <control type="button" id="102">
                    <width>280</width>
                    <height>60</height>
                    <font>font14_title</font>
                    <textcolor>99FFFFFF</textcolor>
                    <focusedcolor>FFFFFFFF</focusedcolor>
                    <align>center</align>
                    <label>+ KID</label>
                    <texturefocus colordiffuse="44FFFFFF">Profile\button-focus.png</texturefocus>
                    <texturenofocus colordiffuse="22FFFFFF">Profile\button-nofocus.png</texturenofocus>
                    <onleft>101</onleft>
                    <onright>101</onright>
                    <onup>50</onup>
                    <ondown>103</ondown>
                </control>

            </control>

            <!-- GERENCIAR PERFIS -->
            <control type="button" id="103">
                <left>710</left>
                <top>870</top>
                <width>500</width>
                <height>50</height>
                <align>center</align>
                <font>font13</font>
                <textcolor>88FFFFFF</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <label>GERENCIAR PERFIS</label>
                <texturefocus colordiffuse="44FFFFFF">Profile\button-focus.png</texturefocus>
                <texturenofocus colordiffuse="22FFFFFF">Profile\button-nofocus.png</texturenofocus>

                <onup>101</onup>
                <ondown>103</ondown>
                <onleft>103</onleft>
                <onright>103</onright>

                <animation effect="fade" start="70" end="100" time="200">Focus</animation>
            </control>

        </control>
    </controls>
</window>
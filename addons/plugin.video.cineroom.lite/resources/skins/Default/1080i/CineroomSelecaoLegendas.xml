<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">9600</defaultcontrol>
    <animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    <controls>

        <!-- Overlay escuro sobre o video -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="D0000000">AddonWindow/white.png</texture>
        </control>

        <!-- Painel central -->
        <control type="group">
            <left>310</left>
            <top>30</top>
            <animation effect="slide" start="0,40" end="0,0" time="300" tween="sine">WindowOpen</animation>

            <!-- Titulo -->
            <control type="label">
                <left>0</left><top>0</top><width>1300</width><height>60</height>
                <font>font22_title</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Window.Property(legendas.titulo)]</label>
            </control>

            <!-- Lista -->
            <control type="list" id="9600">
                <left>0</left><top>200</top>
                <width>1300</width><height>660</height>
                <onleft>9600</onleft><onright>9600</onright>
                <itemgap>10</itemgap>
                <scrolltime tween="sine">250</scrolltime>

                <itemlayout height="110">
                    <control type="image">
                        <left>0</left><top>0</top><width>1300</width><height>104</height>
                        <texture colordiffuse="FF1F2020" border="20">panel.png</texture>
                    </control>
                    <control type="label">
                        <left>35</left><top>14</top><width>1100</width><height>44</height>
                        <font>font20_title</font>
                        <textcolor>FFDDDDDD</textcolor>
                        <label>$INFO[ListItem.Property(lang_name)]</label>
                    </control>
                    <control type="label">
                        <left>35</left><top>62</top><width>1050</width><height>34</height>
                        <font>font13</font>
                        <textcolor>FF999999</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <scroll>false</scroll>
                    </control>
                    <control type="label">
                        <right>35</right><top>62</top><width>200</width><height>34</height>
                        <font>font13</font>
                        <textcolor>FF00CC66</textcolor>
                        <align>right</align>
                        <label>VERIFICADA</label>
                        <visible>String.IsEqual(ListItem.Property(trusted),true)</visible>
                    </control>
                </itemlayout>

                <focusedlayout height="110">
                    <control type="image">
                        <left>0</left><top>0</top><width>1300</width><height>104</height>
                        <texture colordiffuse="FF0084FF" border="20">panel.png</texture>
                    </control>
                    <control type="label">
                        <left>35</left><top>14</top><width>1100</width><height>44</height>
                        <font>font20_title</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Property(lang_name)]</label>
                    </control>
                    <control type="label">
                        <left>35</left><top>62</top><width>1050</width><height>34</height>
                        <font>font13</font>
                        <textcolor>FFEEEEEE</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <scroll>true</scroll>
                    </control>
                    <control type="label">
                        <right>35</right><top>62</top><width>200</width><height>34</height>
                        <font>font13</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <align>right</align>
                        <label>VERIFICADA</label>
                        <visible>String.IsEqual(ListItem.Property(trusted),true)</visible>
                    </control>
                </focusedlayout>
            </control>
        </control>

    </controls>
</window>
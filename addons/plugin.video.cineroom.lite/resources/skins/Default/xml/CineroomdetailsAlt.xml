<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">301</defaultcontrol>
    <onback>Close</onback>

    <animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>

    <controls>

        <!-- Fundo preto sólido -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="FF0A0F24">AddonWindow/white.png</texture>
        </control>

        <!-- Backdrop -->
        <control type="image">
            <aspectratio>scale</aspectratio>
            <width>1920</width>
            <height>1080</height>
            <texture>$INFO[Window.Property(backdrop)]</texture>
        </control>

        <!-- Overlay escuro -->
        <control type="image">
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="CC000000">AddonWindow/white.png</texture>
        </control>

        <!-- Overlay inferior -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>common/gradient_bottom.png</texture>
        </control>

        <!-- Data e hora do sistema -->
        <control type="group">
            <right>10</right>
            <top>0</top>
            <width>320</width>
            <height>40</height>

        <control type="label">
            <left>37</left>
            <top>0</top>
            <width>280</width>
            <height>20</height>
            <font>font10</font>
            <textcolor>AAFFFFFF</textcolor>
            <align>right</align>
            <label>$INFO[System.Time]</label>
        </control>

        <control type="label">
            <left>0</left>
            <top>25</top>
            <width>320</width>
            <height>35</height>
            <font>font10</font>
            <textcolor>66FFFFFF</textcolor>
            <align>right</align>
            <label>$INFO[System.Date]</label>
        </control>

        <control type="image">
            <left>75</left>
            <top>40</top>
            <width>400</width>
            <height>100</height>
            <aspectratio>keep</aspectratio>
            <texture>logo.png</texture>
            <colordiffuse>FFFFFFFF</colordiffuse>
        </control>
    </control>

        <!-- Área de informações do título -->
        <control type="group">
            <left>45</left>
            <top>425</top>
            <width>1100</width>
            <height>200</height>

        <!-- Título textual (fallback sem clearlogo) -->
        <control type="label">
            <left>0</left><top>0</top>
            <width>990</width><height>72</height>
            <font>font52_title</font>
            <textcolor>FFFFFFFF</textcolor>
            <shadowcolor>CC000000</shadowcolor>
            <align>left</align><aligny>center</aligny>
            <wrapmultiline>true</wrapmultiline>
            <maxlines>2</maxlines>
            <label>$INFO[Window.Property(title)]</label>
        </control>

            <!-- Metadados -->
            <control type="grouplist" id="400">
                <left>0</left><top>115</top>
                <width>1200</width><height>55</height>
                <orientation>horizontal</orientation>
                <itemgap>8</itemgap>
                <aligny>center</aligny>
                <onup>999</onup>
                <ondown>301</ondown>

                <control type="label">
                    <width>auto</width><height>32</height>
                    <font>font14</font><textcolor>FFCCCCCC</textcolor><shadowcolor>88000000</shadowcolor>
                    <label>$INFO[Window.Property(year)] • $INFO[Window.Property(duration)] • </label>
                    <visible>String.IsEqual(Window.Property(media_type),movie)</visible>
                </control>
                <control type="label">
                    <width>auto</width><height>32</height>
                    <font>font14</font><textcolor>FFCCCCCC</textcolor><shadowcolor>88000000</shadowcolor>
                    <label>$INFO[Window.Property(year)] • </label>
                    <visible>String.IsEqual(Window.Property(media_type),tvshow)</visible>
                </control>
                <control type="image">
                    <width>45</width><height>45</height>
                    <aspectratio>keep</aspectratio>
                    <texture>Ratings/tmdb.png</texture>
                    <visible>!IsEmpty(Window.Property(rating))</visible>
                </control>
                <control type="label">
                    <width>auto</width><height>32</height>
                    <font>font14</font><textcolor>FFFFFFFF</textcolor><shadowcolor>88000000</shadowcolor>
                    <label>  $INFO[Window.Property(rating)] • </label>
                    <visible>!IsEmpty(Window.Property(rating))</visible>
                </control>
                <control type="image">
                    <width>45</width><height>45</height>
                    <aspectratio>keep</aspectratio>
                    <texture>Ratings/$INFO[Window.Property(certification)].png</texture>
                    <visible>!IsEmpty(Window.Property(certification))</visible>
                </control>
            </control>


            <control type="grouplist">
                <left>0</left><top>185</top>
                <width>1200</width><height>55</height>
                <orientation>horizontal</orientation>
                <itemgap>10</itemgap>
                <aligny>center</aligny>
                <onup>301</onup>
                <ondown>301</ondown>

            <control type="button" id="401">
                    <visible>!String.IsEmpty(Window.Property(Genre.1.Label))</visible>
                    <width>auto</width><height>45</height>
                    <label>$INFO[Window.Property(Genre.1.Label)]</label>
                    <font>font13</font><align>center</align><textoffsetx>20</textoffsetx>
                    <texturefocus border="8" colordiffuse="44FFFFFF">panel.png</texturefocus>
                    <texturenofocus border="22" colordiffuse="FF2A2A2A">panel.png</texturenofocus>
                    <textcolor>FFB3B3B3</textcolor><focusedcolor>FF000000</focusedcolor>
                </control>
                <control type="button" id="402">
                    <visible>!String.IsEmpty(Window.Property(Genre.2.Label))</visible>
                    <width>auto</width><height>45</height>
                    <label>$INFO[Window.Property(Genre.2.Label)]</label>
                    <font>font13</font><align>center</align><textoffsetx>20</textoffsetx>
                    <texturefocus border="8" colordiffuse="44FFFFFF">panel.png</texturefocus>
                    <texturenofocus border="22" colordiffuse="FF2A2A2A">panel.png</texturenofocus>
                    <textcolor>FFB3B3B3</textcolor><focusedcolor>FF000000</focusedcolor>
                </control>
                <control type="button" id="403">
                    <visible>!String.IsEmpty(Window.Property(Genre.3.Label))</visible>
                    <width>auto</width><height>45</height>
                    <label>$INFO[Window.Property(Genre.3.Label)]</label>
                    <font>font13</font><align>center</align><textoffsetx>20</textoffsetx>
                    <texturefocus border="8" colordiffuse="44FFFFFF">panel.png</texturefocus>
                    <texturenofocus border="22" colordiffuse="FF2A2A2A">panel.png</texturenofocus>
                    <textcolor>FFB3B3B3</textcolor><focusedcolor>FF000000</focusedcolor>
                </control>
            </control>    

            <!-- Tagline -->
            <control type="label">
                <left>0</left>
                <top>265</top>
                <width>1500</width>
                <height>72</height>
                <font>font25_narrow</font>
                <textcolor>FF909090</textcolor>
                <shadowcolor>44000000</shadowcolor>
                <label>[I]$INFO[Window.Property(tagline)][/I]</label>
                <visible>!String.IsEmpty(Window.Property(tagline))</visible>
            </control>

            <!-- Plot -->
            <control type="label">
                <left>0</left>
                <top>335</top>
                <width>830</width>
                <height>100</height>
                <font>font12</font>
                <textcolor>FFE0E0E0</textcolor>
                <shadowcolor>CC000000</shadowcolor>
                <label>$INFO[Window.Property(plot)]</label>
                <wrapmultiline>true</wrapmultiline>
                <maxlines>3</maxlines>
                <visible>True</visible>
            </control>


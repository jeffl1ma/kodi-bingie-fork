<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.cineroom.lite" version="2.1.4" name="Cineroom [COLOR gold]Lite[/COLOR]" provider-name="Gael">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.requests"/>
    <import addon="script.cineroom.burst" version="2.1.7"/>
  </requires>

  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>

  <extension point="xbmc.service" library="service.py" start="startup"/>

  <extension point="xbmc.addon.metadata">
    <reuselanguageinvoker>true</reuselanguageinvoker>
    <description lang="pt_BR">Biblioteca de filmes e séries. Apenas organizamos os conteudos, nenhum json contem links diretos</description>
    <disclaimer lang="pt_BR">OBRIGADO PELA PREFERÊNCIA S2</disclaimer>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://cineroom2.github.io</source>
    <email>cineroom.ofc@gmail.com</email>
    <assets>
      <icon>resources/images/icon.png</icon>
      <fanart>resources/images/fanart.png</fanart>
    </assets>
  </extension>
</addon>